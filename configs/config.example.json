{
  "_note": "只有下面这些字段会被 Python 版读取（wb_gateway.py:489-565）。上游 Go 版遗留的 schedule.* / prompt.* / upstash.* / session_sticky.* / pool.max_in_flight / pool.degrade_* / server.read_timeout / logging.* / upstream.header_timeout_seconds 等键在本分支不生效。改完需重启网关。",
  "listen": ":7863",
  "api_key": "test_key",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "upstream": {
    "base_url": "https://copilot.tencent.com",
    "timeout_seconds": 120
  },
  "global": {
    "chat_base": ""
  },
  "models": {
    "file": "./data/models.json"
  },
  "usage": {
    "enabled": true,
    "file": "./data/usage.json",
    "retention_days": 90,
    "flush_interval_seconds": 5
  },
  "pool": {
    "distribution": "priority",
    "region": "",
    "credit_floor": 100,
    "prefer_expiring": true,
    "expiring_soon": "168h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m"
  },
  "cooldown": {
    "soft_rate": "600s"
  }
}
